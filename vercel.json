{
  "routes": [
    { "src": "/sw.js", "dest": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/workbox-(.*)\\.js", "dest": "/workbox-$1.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/manifest.json", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }, "continue": true },
    { "src": "/index.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }, "continue": true },
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/app/(.*)", "dest": "/index.html" },
    { "src": "/table/(.*)", "dest": "/index.html" },
    { "src": "/privacy-policy", "dest": "/privacy-policy.html" },
    { "src": "/terms-of-service", "dest": "/terms-of-service.html" },
    { "src": "/how-to", "dest": "/how-to.html" },
    { "src": "/how-to/", "dest": "/how-to.html" },
    { "src": "/howto", "dest": "/how-to.html" },
    { "src": "/how-to.html", "dest": "/how-to.html" },
    { "src": "/icons/(.*)", "dest": "/icons/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/jesus-at-table.png", "dest": "/jesus-at-table.png" },
    { "src": "/jesus-welcome.png", "dest": "/jesus-welcome.png" },
    { "src": "/dwj-qr.png", "dest": "/dwj-qr.png", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/dwj-qr.svg", "dest": "/dwj-qr.svg", "headers": { "Cache-Control": "public, max-age=86400", "Content-Type": "image/svg+xml" } },
    { "src": "/dwj-family-story.mp4", "dest": "/dwj-family-story.mp4", "headers": { "Cache-Control": "public, max-age=31536000, immutable", "Content-Type": "video/mp4" } },
    { "src": "/dwj-family-video-poster.jpg", "dest": "/dwj-family-video-poster.jpg", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/dwj-how-to.mp4", "dest": "/dwj-how-to.mp4", "headers": { "Cache-Control": "public, max-age=31536000, immutable", "Content-Type": "video/mp4" } },
    { "src": "/dwj-how-to-poster.jpg", "dest": "/dwj-how-to-poster.jpg", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/favicon.png", "dest": "/favicon.png" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/.well-known/assetlinks.json", "dest": "/.well-known/assetlinks.json", "headers": { "Content-Type": "application/json" } },
    { "src": "/.well-known/apple-app-site-association", "dest": "/.well-known/apple-app-site-association", "headers": { "Content-Type": "application/json" } },
    { "src": "^/$", "dest": "/landing.html" },
    { "src": "/delete-account", "dest": "/delete-account.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
