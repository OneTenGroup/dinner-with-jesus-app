node_modules/
dist/
.env
.env.*
!.env.example
*.local
.DS_Store
supabase/.temp/

# Android TWA (android-twa/) -- build outputs, machine-local SDK path, and
# any signing material that should NEVER live inside this repo. The real
# upload keystore/passwords/PEM are stored outside the repo entirely (see
# docs/DWJ_ANDROID_TWA_RELEASE_PROCESS.md) -- these patterns are defense
# in depth in case one is ever placed here by mistake.
android-twa/build/
android-twa/app/build/
android-twa/.gradle/
android-twa/local.properties
android-twa/release/
*.aab
*.apk

# iOS (ios/) -- CocoaPods/Xcode local state and build products. The
# actual Xcode project, Info.plist, and asset catalogs ARE committed --
# only machine-local/build-generated content is excluded here.
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
*.ipa
*.p12
*.mobileprovision
*.certSigningRequest
*.jks
*.keystore
*.pem
*keystore*.properties
signing.properties
CREDENTIALS-DO-NOT-COMMIT*
