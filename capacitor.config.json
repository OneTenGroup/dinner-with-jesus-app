{
  "appId": "ai.flippingtables.app",
  "appName": "Dinner with Jesus",
  "webDir": "dist",
  "backgroundColor": "#0D1829",
  "server": {
    "url": "https://flippingtables.ai",
    "cleartext": false,
    "allowNavigation": [
      "flippingtables.ai",
      "www.flippingtables.ai",
      "*.supabase.co"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0D1829",
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0D1829",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    }
  }
}
